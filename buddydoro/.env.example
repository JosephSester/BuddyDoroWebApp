MONGO_URI=your_mongodb_uri_here
JWT_SECRET=your_jwt_secret_here
OPENAI_API_KEY=your_openai_api_key_here

# Where the browser loads the app (no trailing slash). Spotify OAuth redirects here after login.
# Must match the URL you actually open in the browser (same host/port/path).
# Use the same hostname you type in the address bar (localhost vs 127.0.0.1) everywhere — the
# frontend resolves the API to http(s)://<that-host>:3000/api so it matches SPOTIFY_REDIRECT_URI.
# Examples: http://localhost:3000  |  http://127.0.0.1:5501/buddydoro/apps/web/public
FRONTEND_URL=http://localhost:3000

# Spotify — create an app at https://developer.spotify.com/dashboard
# SPOTIFY_REDIRECT_URI must match exactly what you add under "Redirect URIs" (same host, http vs https, path).
# Example: http://127.0.0.1:3000/api/spotify/callback
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=
